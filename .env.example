# Copy to .env and edit. Every value is optional -- defaults live in
# hopper_greenout.py and are sane for running the script in place.

# Repo the script commits/pushes to. Defaults to this script's own directory.
HG_TARGET_REPO_PATH=/absolute/path/to/repo

# Market data source. Defaults to Yahoo Finance's free chart endpoint,
# which needs no key. Point this at a paid provider and set the key below
# if you outgrow the free tier.
HG_DATA_SOURCE_URL=https://query1.finance.yahoo.com/v8/finance/chart/{ticker}
HG_DATA_API_KEY=

# How often --loop fetches, in minutes.
HG_SCHEDULE_MINUTES=10

# git remote/branch to push to. Blank branch = auto-detect current branch.
HG_GIT_REMOTE=origin
HG_GIT_BRANCH=
